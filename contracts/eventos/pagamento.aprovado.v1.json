{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.plataforma/eventos/pagamento.aprovado.v1.json",
  "title": "pagamento.aprovado.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "version", "event_id", "occurred_at", "data"],
  "properties": {
    "event": { "const": "pagamento.aprovado" },
    "version": { "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "payment_id", "order_id", "amount_cents", "method", "mp_payment_id", "customer"],
      "properties": {
        "site_id": { "type": "string", "description": "Atribuição — pagamentos apenas ecoa o valor recebido na intent" },
        "payment_id": { "type": "string" },
        "order_id": { "type": "string" },
        "amount_cents": { "type": "integer", "minimum": 1 },
        "method": { "enum": ["pix", "card"] },
        "mp_payment_id": { "type": "string" },
        "product_id": {
          "type": "string",
          "description": "O produto que a pessoa comprou, e e o que a matricula guarda para dizer de qual curso ela e aluna (DECISAO-cursos-matriculas-e-alunos.md, [INV-ALU-C1]). OPCIONAL e AUSENTE quando o checkout nao informou, nunca string vazia: ausencia e 'nao sei', e string vazia seria 'sei que e nada', que nao existe. Atribuicao, como o site_id: pagamentos ecoa o que veio no metadata da intent e nunca interpreta. Quem consome e responsavel por decidir o que faz sem ele, e nunca por adivinhar."
        },
        "customer": {
          "type": "object",
          "required": ["email", "name"],
          "properties": {
            "email": { "type": "string", "format": "email" },
            "name": { "type": "string" },
            "phone": { "type": "string" }
          }
        }
      }
    }
  }
}
