{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.plataforma/eventos/pagamento.recusado.v1.json",
  "title": "pagamento.recusado.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "version", "event_id", "occurred_at", "data"],
  "properties": {
    "event": { "const": "pagamento.recusado" },
    "version": { "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "payment_id", "order_id", "amount_cents", "method", "reason_code", "customer"],
      "properties": {
        "site_id": { "type": "string" },
        "payment_id": { "type": "string" },
        "order_id": { "type": "string" },
        "amount_cents": { "type": "integer", "minimum": 1 },
        "method": { "enum": ["pix", "card"] },
        "reason_code": { "type": "string", "description": "status_detail do MP, ex.: cc_rejected_insufficient_amount" },
        "customer": {
          "type": "object",
          "required": ["email", "name"],
          "properties": {
            "email": { "type": "string", "format": "email" },
            "name": { "type": "string" },
            "phone": { "type": "string" }
          }
        }
      }
    }
  }
}
