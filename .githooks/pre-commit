#!/usr/bin/env bash
# =============================================================================
# GANCHO LOCAL — arquivo GERADO do painel não entra em commit (Onda 3).
#
# Desde 28/08/2026 `painel/painel.html` e `painel/livro-AAAAMM.js` são
# materializados pela integração e não moram mais no Git: eles eram a colisão
# diária entre robôs, porque todo registro novo reescrevia os dois arquivos
# inteiros. O `.gitignore` já os mantém fora — este gancho pega o caso que o
# `.gitignore` não pega: `git add -f`, deliberado ou por hábito.
#
# É o degrau LOCAL da escada (vale só nesta máquina e neste clone). O degrau que
# vale para todo mundo é `ci/verificar_painel.py`, que reprova na muralha se um
# gerado voltar ao índice — este aqui só evita a viagem inútil até o CI.
#
# Escapatória deliberada e visível, para o dia em que o desenho mudar:
#   PERMITIR_GERADO_DO_PAINEL=sim git commit ...
# =============================================================================
gerados="$(git diff --cached --name-only --diff-filter=AM \
  | grep -E '^painel/(painel\.html|livro-[0-9]{6}\.js)$' || true)"

if [[ -n "$gerados" ]]; then
  if [[ "${PERMITIR_GERADO_DO_PAINEL:-}" == "sim" ]]; then
    echo "⚠️  Arquivo gerado do painel commitado com permissão explícita."
    exit 0
  fi
  echo "❌ BLOQUEADO: arquivo GERADO do painel no commit."
  echo "$gerados" | sed 's/^/     /'
  echo
  echo "   Estes arquivos são materializados pela integração desde 28/08/2026"
  echo "   (Onda 3 — escritor único). Commitá-los devolve a colisão diária:"
  echo "   todo registro novo reescreve o arquivo inteiro, e dois robôs no"
  echo "   mesmo dia conflitam sem ter escrito uma linha em comum."
  echo
  echo "   O que fazer: git restore --staged $(echo "$gerados" | tr '\n' ' ')"
  echo "   A fonte é painel/registros/ — é ELA que viaja no PR."
  exit 1
fi

# =============================================================================
# O MESMO GANCHO, PARA OS GERADOS DAS ARMADILHAS (30/08/2026, TAR-022).
#
# `armadilhas/INDICE.md`, `GUARDAS.json` e `SINAIS.json` saem de
# `ci/indice_de_armadilhas.py`. Eles adoeceram exatamente como o painel: a lei
# manda todo robô acrescentar uma entrada ao fim de cada tarefa, e cada entrada
# nova reescreve os três arquivos inteiros. Medido em 30/08/2026, num lote de 4
# robôs: DOIS PRs devolvidos pela pista pelo mesmo conflito, o #573 duas vezes.
#
# O degrau que vale para todo mundo é `ci/muralha-do-indice.sh`, na muralha de
# todo PR. Este aqui só evita a viagem inútil até o CI.
#
# Escapatória deliberada e visível:
#   PERMITIR_GERADO_DAS_ARMADILHAS=sim git commit ...
# =============================================================================
gerados_armadilhas="$(git diff --cached --name-only --diff-filter=AM \
  | grep -E '^armadilhas/(INDICE\.md|GUARDAS\.json|SINAIS\.json)$' || true)"

if [[ -n "$gerados_armadilhas" ]]; then
  if [[ "${PERMITIR_GERADO_DAS_ARMADILHAS:-}" == "sim" ]]; then
    echo "⚠️  Arquivo gerado das armadilhas commitado com permissão explícita."
    exit 0
  fi
  echo "❌ BLOQUEADO: arquivo GERADO das armadilhas no commit."
  echo "$gerados_armadilhas" | sed 's/^/     /'
  echo
  echo "   Estes arquivos são materializados pela integração desde 30/08/2026"
  echo "   (TAR-022 — a cura da Onda 3 aplicada à memória de campo). Commitá-los"
  echo "   devolve a colisão diária: toda armadilha nova reescreve os três"
  echo "   arquivos inteiros, e dois robôs do mesmo lote conflitam sem ter"
  echo "   escrito uma linha em comum."
  echo
  echo "   O que fazer: git restore --staged $(echo "$gerados_armadilhas" | tr '\n' ' ')"
  echo "   A fonte é armadilhas/NNN-slug.md — é ELA que viaja no PR."
  exit 1
fi

# =============================================================================
# O DEGRAU LOCAL DA ARMADILHA 185 (06/09/2026) — registro sem número, na mão.
#
# A porta do pouso (`ci/mergear.py`) recusa PR de entrega cujo registro não
# cita o próprio número — mas ela só fala depois de uma rodada inteira de
# checks. Medido em 06/09/2026: UMA sessão foi pega QUATRO vezes no mesmo dia,
# pelo mesmo erro de ordem. Este degrau move a recusa para o instante do
# commit; a regra, a recusa que ensina e a escapatória moram em
# `ci/registro_no_commit.py`. Só o exit 1 dele prende o commit: python
# ausente ou git engasgado NUNCA viram commit preso — quem faz valer é a porta.
# =============================================================================
python ci/registro_no_commit.py
codigo_do_degrau=$?
if [[ "$codigo_do_degrau" -eq 1 ]]; then
  exit 1
fi
exit 0
