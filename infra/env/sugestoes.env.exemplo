# Célula: sugestoes — a Caixa de Sugestões (DECISAO-EVO-01)
# Copie para /opt/plataforma/env/sugestoes.env e preencha. O arquivo REAL é
# segredo, escrito à mão na VPS pelo mantenedor (INV-P8, Lei 5): nenhum valor
# de verdade entra neste exemplo, e nenhum agente vê o arquivo de lá.
#
# NÃO tem ALLOWED_HOSTS de propósito: esta célula fixa ALLOWED_HOSTS = ["*"] no
# config/settings.py e NÃO lê a variável — declarar aqui seria decoração que um
# dia alguém acredita (armadilhas/029, seção "de quebra").

# ── Fail-hard no import: sem uma destas duas, o container não sobe. ──────────
DJANGO_SECRET_KEY=            # OBRIGATÓRIA — sem valor, ImproperlyConfigured
DATABASE_URL=postgres://sugestoes_user:TROQUE_sugestoes@postgres:5432/sugestoes_db

DEBUG=0

# O prefixo público. O Traefik NÃO o remove; quem o aplica é FORCE_SCRIPT_NAME
# (config/settings.py), nunca o urls.py. Mudar a Caixa de endereço = mudar esta
# linha + a regra do router `sugestoes` no traefik/dynamic/plataforma.yml.
# Ele também define SESSION_COOKIE_PATH e CSRF_COOKIE_PATH: o cookie da Caixa
# não sai para o resto de meshcraft.top, onde mora o funil.
SCRIPT_NAME=/forms/sugestoes

# Redis: /0 é o barramento de eventos, compartilhado por todas as células; a
# fila do Huey desta célula é a /8 (as anteriores vão de /1 a /7 — catalogo,
# quiz, leads, checkout, pagamentos, alunos, mensageria).
REDIS_STREAMS_URL=redis://redis:6379/0
HUEY_REDIS_URL=redis://redis:6379/8

# ── Google: prova QUEM É (DECISAO-EVO-01 §2 e §6) ───────────────────────────
# O aplicativo OAuth é criado UMA vez pelo mantenedor no console do Google, com
# o endereço de retorno EXATO (uma letra diferente = redirect_uri_mismatch):
#   https://meshcraft.top/forms/sugestoes/entrar/google/retorno
# Lidas no PONTO DE USO (apps/core/clients.py): faltando, quem fecha é só a
# porta de entrada — o container sobe e o resto da Caixa continua servindo.
GOOGLE_CLIENT_ID=TROQUE_id_do_cliente_do_google
GOOGLE_CLIENT_SECRET=TROQUE_segredo_do_cliente_do_google

# ── alunos: decide SE PODE (Lei 3 — por HTTP, nunca lendo o banco de lá) ─────
# A URL é o `servers` de contracts/alunos.openapi.yaml: rede interna do Docker,
# jamais a borda pública. O token é o do PAR sugestoes→alunos, e do outro lado
# ele entra como TOKENS_ACEITOS_SUGESTOES no env/alunos.env — sem uma linha de
# código na célula alunos (o settings.py de lá monta o conjunto a partir de
# QUALQUER variável TOKENS_ACEITOS_*).
ALUNOS_API_URL=http://alunos:8000/api/alunos
ALUNOS_API_TOKEN=TROQUE_token_sugestoes_para_alunos

# ── identidade: prova QUEM E (DECISAO-celula-de-identidade, 25/08/2026) ──────
# Desde essa decisao a Caixa NAO tem login proprio: ela pergunta a celula
# `identidade` pela operacao `getSessionFull` (a resposta COM e-mail, que esta
# celula precisa para conferir as listas DELA: matricula na `alunos` e a lista
# de staff abaixo). Escritas pelo infra/provisionar-identidade.sh, nao a mao.
#
# O token e do PAR sugestoes->identidade, e precisa estar do outro lado em
# DUAS variaveis: TOKENS_ACEITOS_SUGESTOES (pode perguntar) e
# TOKENS_COMPLETOS_SUGESTOES (pode receber o e-mail). O token do `funil` e
# OUTRO valor, de proposito — se fossem iguais, o site inteiro passaria a
# receber o e-mail das pessoas sem que nada acusasse.
#
# Faltando, a Caixa FECHA explicando ("nao conseguimos conferir sua entrada
# agora") — autorizacao e fail-closed aqui, ao contrario do reconhecimento de
# exibicao do funil, que falha aberto.
IDENTIDADE_API_URL=http://identidade:8000/interno
IDENTIDADE_API_TOKEN=TROQUE_token_sugestoes_para_identidade

# ── notificacoes: a caixa central de avisos (Fase 3/4 do sininho) ───────────
# Desde essa migração a tela `/avisos` e o sino no trilho NÃO leem mais o
# `Aviso` local — leem `GET /resumo`/`GET /avisos`/`POST /marcar-lida(s)`
# desta célula (`contracts/notificacoes.openapi.yaml`). Escritas pelo
# provisionamento da VPS, não à mão — o mesmo par que o `funil` já usa para o
# sino dele, com token PRÓPRIO (`TOKENS_ACEITOS_SUGESTOES` do lado da
# `notificacoes`, diferente do `TOKENS_ACEITOS_FUNIL`).
#
# **As duas telas têm regra de falha OPOSTA** — leiam
# `docs/decisoes/DECISAO-fase-4-do-sininho.md` Escolha 2 antes de mexer aqui:
# faltando qualquer uma das duas, o SINO (em toda página) some sem número e
# nunca quebra — mesmo fail-open do `funil`, guarda em
# `tests/test_sino_le_a_notificacoes.py`. A TELA `/avisos`, ao contrário,
# mostra uma frase de erro em vez de fingir "zero avisos" — guarda em
# `tests/test_avisos_le_a_notificacoes.py`. Nenhuma das duas derruba a Caixa
# com 500: o que muda é o texto que a pessoa vê.
NOTIFICACOES_API_URL=http://notificacoes:8000/api/notificacoes
NOTIFICACOES_API_TOKEN=TROQUE_token_sugestoes_para_notificacoes
# Escritas por infra/provisionar-porta-de-avisos.sh (acrescenta/atualiza SÓ
# estas duas chaves — nunca à mão, nunca reescreve o arquivo, mesmo padrão do
# SUGESTOES_APROVADORES abaixo).
#
# CUIDADO, mesma família da armadilha do SUGESTOES_APROVADORES: se
# `infra/provisionar-sugestoes.sh` (que reescreve este env INTEIRO a partir do
# molde dele) rodar de novo, a trava de deriva dele PARA em vez de apagar
# estas duas linhas — mas só porque foi ensinada a reconhecê-las. A cura, se
# isso acontecer, é rodar `infra/provisionar-porta-de-avisos.sh` logo depois;
# ele é idempotente.

# ── Quem modera (DECISAO-EVO-01 §4) ─────────────────────────────────────────
# Lista de e-mails separados por vírgula. O papel NÃO é gravado em lugar
# nenhum: é derivado desta lista a cada requisição, então trocar quem é staff é
# editar esta linha e reiniciar a célula — sem migração, sem deploy de código.
# Ausente ou vazia ⇒ ninguém é staff, e a Caixa continua servindo alunos.
SUGESTOES_STAFF_EMAILS=voce@exemplo.com,outra.pessoa@exemplo.com

# ── Quem AUTORIZA uma ideia a entrar em desenvolvimento (25/08/2026) ─────────
# NÃO é a mesma coisa que a lista de staff acima. Staff MODERA (lê, responde,
# arquiva); aprovador é quem manda uma ideia para desenvolvimento de verdade.
# O mantenedor decidiu que essa autoridade é de UMA pessoa — esta lista costuma
# ter um endereço só, e herdar a lista de staff seria ampliá-la em silêncio.
#
# Lida no PONTO DE USO e FAIL-CLOSED, ao contrário da de staff: ausente ou
# vazia ⇒ NINGUÉM aprova. A Caixa continua inteira (recebe, mostra, modera) e o
# caminho de aprovar simplesmente não existe para pessoa alguma. Nada de
# migração, nada de deploy de código: trocar quem aprova é trocar esta linha.
#
# ESTA LINHA NÃO SE ESCREVE À MÃO. Quem a põe na VPS é o
# `infra/provisionar-aprovadores.sh`, numa linha só — ele acrescenta/atualiza
# SÓ esta chave (nunca reescreve o arquivo, que já tem segredos vivos) e copia
# dono e modo de `env/alunos.env` (armadilhas/091).
#
# CUIDADO: `infra/provisionar-sugestoes.sh` regenera este env INTEIRO a partir
# do molde dele, que não tem esta chave — se aquele script rodar de novo, esta
# linha some e a Caixa volta a "ninguém aprova" sem barulho. A cura é rodar o
# provisionar-aprovadores.sh logo depois; ele é idempotente.
SUGESTOES_APROVADORES=TROQUE_email_de_quem_aprova@exemplo.com

# ── O MENU DO TOPO (a mesma configuracao do site, 31/08/2026) ───────────────
# A Caixa mostra o MESMO menu do site, e o menu e DADO DO SITE: ele mora no
# `catalogo` e o mantenedor o configura em /admin/menu/. Esta celula so LE.
#
# Escritas na VPS por `infra/provisionar-par-do-menu.sh`. Lidas no PONTO DE USO,
# nunca no __init__ de um cliente (armadilhas/097). Ausentes, a Caixa abre
# exatamente como antes, SEM menu no topo, e nada quebra.
#
# O token e o do par `sugestoes→catalogo`, e precisa estar tambem em
# TOKENS_ACEITOS_SUGESTOES do lado do catalogo, com o MESMO valor. O script
# escreve os dois e confere.
CATALOGO_API_URL=http://catalogo:8000/api/catalogo
TOKEN_CATALOGO=TROQUE_token_sugestoes_para_catalogo
