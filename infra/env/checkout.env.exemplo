# Célula: checkout — adjacente ao dinheiro, mas SEM credencial MP secreta (INV-P8)
DJANGO_SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=*   # multissítio: o middleware CONV-SITE valida o Host (INV-P11)
SCRIPT_NAME=/checkout
DATABASE_URL=postgres://checkout_user:TROQUE_checkout@postgres:5432/checkout_db
REDIS_STREAMS_URL=redis://redis:6379/0
HUEY_REDIS_URL=redis://redis:6379/4
CATALOGO_API_URL=http://catalogo:8000/api/catalogo
TOKEN_CATALOGO=TROQUE_token_checkout_para_catalogo
PAGAMENTOS_API_URL=http://pagamentos:8000/api/pagamentos
TOKEN_PAGAMENTOS=TROQUE_token_checkout_para_pagamentos
# Public key do MP p/ montar o Card Payment Brick no navegador (NÃO é segredo):
MP_PUBLIC_KEY=TEST-TROQUE
