# Célula: forum — o fórum da escola (DECISAO-forum-da-escola.md)
# O arquivo REAL é escrito na VPS por infra/provisionar-forum.sh.
DJANGO_SECRET_KEY=
DEBUG=0
DATABASE_URL=postgres://forum_user:TROQUE_forum@postgres:5432/forum_db

# O prefixo público. O Traefik NÃO remove o prefixo — quem o conhece é esta
# variável, nunca o urls.py (`armadilhas/029`). E é CAMINHO, não subdomínio:
# o cookie de sessão do site é de host, então em forum.meshcraft.top o login
# único quebraria (lei §2).
SCRIPT_NAME=/forum

# ── Quem é a pessoa (par forum→identidade) ──────────────────────────────────
# O fórum repassa o cookie OPACO e pergunta. Ele nunca lê nem escreve o cookie
# ([INV-P12]) — quem o assina é a célula identidade, e só ela.
# O token precisa estar TAMBÉM em TOKENS_COMPLETOS_FORUM no env da identidade,
# porque o fórum usa a resposta COM e-mail para perguntar à alunos. Os dois
# lados são escritos por infra/provisionar-forum.sh — nunca à mão.
IDENTIDADE_API_URL=http://identidade:8000/interno
IDENTIDADE_API_TOKEN=TROQUE_token_forum_para_identidade

# ── Em que categoria ela está (par forum→alunos) ────────────────────────────
# Reconhecer não é autorizar: a alunos responde a categoria, e QUEM PODE é
# decidido dentro do fórum, fail-closed (lei §3). Falha aqui NUNCA vira
# "é aluno" — vira "não é".
ALUNOS_API_URL=http://alunos:8000/api/alunos
ALUNOS_API_TOKEN=TROQUE_token_forum_para_alunos

# ── Quem fala com autoridade ────────────────────────────────────────────────
# Listas do FÓRUM, nunca papel vindo da identidade — foi exatamente aqui que um
# consultor externo tropeçou na rodada de 28/08.
# VAZIO = NINGUÉM. Fail-closed por construção: variável ausente nunca pode
# significar "todo mundo tem este poder".
#
# FORUM_PROFESSORES é o papel que NASCE com o fórum (lei §5): resposta com selo,
# poder de marcar dúvida como resolvida, moderar sem ser dono do sistema.
FORUM_PROFESSORES=
# Os mesmos administradores do painel. O provisionamento copia de admin.env numa
# FOTOGRAFIA, não numa ligação viva — mudou a lista lá, rode o script de novo.
ADMIN_EMAILS=
# Com que configuração do PostgreSQL a busca indexa e procura. VAZIO significa
# `portuguese`, que é sensível a acento: quem digita "chapeu" não acha "chapéu"
# (`armadilhas/154`), e a tela avisa isso ao não achar nada.
#
# `portugues_sem_acento` é a cura, e ela só existe depois que o provisionamento
# a criar no banco (exige superusuário). Por isso o padrão é VAZIO: apontar para
# uma configuração que não existe quebraria toda escrita e toda busca do fórum,
# com o deploy verde. Quem preenche é o `infra/provisionar-forum.sh`, e só
# quando a criação der certo.
FORUM_BUSCA_CONFIG=

# ── A IA QUE RASCUNHA RESPOSTA (02/09/2026) ────────────────────────────────
# A chave da API da Anthropic. É com ela que o botão "Gerar resposta" existe na
# tela de uma conversa, para professor e administrador.
#
# ESTA É A ÚNICA VARIÁVEL DESTE ARQUIVO QUE O PROVISIONAMENTO NÃO SABE GERAR: ela
# nasce na conta da Anthropic do mantenedor (console.anthropic.com), custa
# dinheiro por uso, e ninguém além dele pode criá-la. O script a REAPROVEITA
# quando já existe no env vivo, e nunca a inventa.
#
# VAZIA = A IA DESLIGADA, e desligada é um estado honesto: o fórum sobe igual, a
# tela de conversa mostra a caixa explicando que falta a chave, e a caixa de
# responder continua funcionando como sempre funcionou. Nada quebra e nada é
# cobrado.
#
# Lida no PONTO DE USO (`services/forum/apps/core/agente.py`), nunca no import:
# trocar a chave aqui passa a valer na geração seguinte, sem reiniciar nada.
ANTHROPIC_API_KEY=

# ── O MENU DO TOPO (a mesma configuracao do site, 31/08/2026) ───────────────
# O forum mostra o MESMO menu do site, e o menu e DADO DO SITE: ele mora no
# `catalogo` e o mantenedor o configura em /admin/menu/. Esta celula so LE.
#
# Escritas na VPS por `infra/provisionar-par-do-menu.sh`. Lidas no PONTO DE USO,
# nunca no __init__ de um cliente (armadilhas/097). Ausentes, o forum abre
# exatamente como antes, SEM menu no topo, e nada quebra.
#
# O token e o do par `forum→catalogo`, e precisa estar tambem em
# TOKENS_ACEITOS_FORUM do lado do catalogo, com o MESMO valor. O script escreve
# os dois e confere.
CATALOGO_API_URL=http://catalogo:8000/api/catalogo
TOKEN_CATALOGO=TROQUE_token_forum_para_catalogo
