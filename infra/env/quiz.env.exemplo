# Célula: quiz (Crivo)
DJANGO_SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=*   # multissítio: o middleware CONV-SITE valida o Host (INV-P11)
SCRIPT_NAME=/quiz             # prefixo público servido pelo gateway
DATABASE_URL=postgres://quiz_user:TROQUE_quiz@postgres:5432/quiz_db
REDIS_STREAMS_URL=redis://redis:6379/0
HUEY_REDIS_URL=redis://redis:6379/2
# Resolução de site (middleware CONV-SITE):
CATALOGO_API_URL=http://catalogo:8000/api/catalogo
TOKEN_CATALOGO=TROQUE_token_quiz_para_catalogo
