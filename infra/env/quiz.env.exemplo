# Célula: quiz (Crivo)
DJANGO_SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=*   # multissítio: o middleware CONV-SITE valida o Host (INV-P11)
SCRIPT_NAME=/quiz             # prefixo público servido pelo gateway
DATABASE_URL=postgres://quiz_user:TROQUE_quiz@postgres:5432/quiz_db
REDIS_STREAMS_URL=redis://redis:6379/0
HUEY_REDIS_URL=redis://redis:6379/2
# Resolução de site (middleware CONV-SITE):
CATALOGO_API_URL=http://catalogo:8000/api/catalogo
TOKEN_CATALOGO=TROQUE_token_quiz_para_catalogo
# Par privado com a jornada do portfólio; vazio mantém a API fechada.
TOKENS_ACEITOS_PAGES=
# Integrações de aquisição e CRM (python manage.py enviar_integracoes).
# Cada serviço só liga quando as variáveis obrigatórias dele estão preenchidas.
# GA4 (Measurement Protocol)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Meta Conversions API (META_TEST_EVENT_CODE é opcional, só para testes)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
# TikTok Events API (TIKTOK_TEST_EVENT_CODE é opcional)
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=
# Klaviyo (KLAVIYO_LIST_ID é opcional)
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=
# ActiveCampaign (AC_LIST_ID é opcional; AC_API_URL ex.: https://conta.api-us1.com)
AC_API_URL=
AC_API_TOKEN=
AC_LIST_ID=
