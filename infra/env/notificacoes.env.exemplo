# Célula: notificacoes — a caixa central de avisos
# O arquivo REAL é escrito na VPS por infra/provisionar-notificacoes.sh.
DJANGO_SECRET_KEY=
DEBUG=0
DATABASE_URL=postgres://notificacoes_user:TROQUE_notificacoes@postgres:5432/notificacoes_db
REDIS_STREAMS_URL=redis://redis:6379/0
# Quantos dias uma notificação LIDA fica no caminho quente antes de ir para o
# arquivo. Opcional: sem ela vale o padrão do settings (30).
NOTIFICACOES_DIAS_ATE_ARQUIVAR=30

# ── Quem pode consultar esta porta (Fase 4 do sininho, 27/08/2026) ──────────
# Bearer estático, um por par consumidor (contracts/README.md §6) — nunca uma
# chave só para os dois. `apps/core/auth.py` monta o conjunto aceito a partir
# de QUALQUER variável TOKENS_ACEITOS_*, sem uma linha de código nesta célula.
# Escritas (os dois lados de cada par) por infra/provisionar-porta-de-avisos.sh
# — nunca à mão. Ausentes até esse passo rodar: o sino do `funil` fica sem
# número e a tela de avisos da `sugestoes` avisa que não consegue buscar —
# nenhuma das duas quebra (é o comportamento esperado, não bug).
TOKENS_ACEITOS_FUNIL=TROQUE_token_funil_para_notificacoes
TOKENS_ACEITOS_SUGESTOES=TROQUE_token_sugestoes_para_notificacoes
# `admin` desde 03/09/2026 (o botao "Testar o aviso no celular" em
# /admin/avisos/). Escrita nos dois lados por
# infra/provisionar-par-do-teste-de-aviso.sh — nunca a mao. Ausente ate esse
# passo rodar: o botao diz "Nao deu para saber" ao clicar, e nada mais muda
# (os avisos de verdade nao usam este par).
TOKENS_ACEITOS_ADMIN=TROQUE_token_admin_para_notificacoes

# ── O aviso na tela do celular (Fase 7, 31/08/2026) ─────────────────────────
# A metade PRIVADA da chave VAPID é o que prova aos servidores de push (Google,
# Apple, Mozilla) que o aviso saiu deste site. Ela nasce na VPS, por
# `infra/provisionar-aviso-no-celular.sh`, e nunca aparece na tela nem no Git.
# A metade PÚBLICA fica aqui só para o script poder reaproveitar o par: quem a
# usa de verdade é o `funil`, no navegador de cada pessoa.
# Ausentes até aquele script rodar: a célula NÃO cai e as cartas continuam
# sendo gravadas — só nenhum aviso sai, e o log diz isso uma vez por processo
# (fail-open, guarda em tests/test_aviso_no_celular.py).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Exigido pelo padrão do web push: por onde um fabricante fala com o dono do
# site se algo der errado com os envios. Não é o e-mail de ninguém.
VAPID_SUBJECT=mailto:contato@meshcraft.top
