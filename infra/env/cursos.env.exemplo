# Célula: cursos, a sala de aula da Meshcraft (DECISAO-celula-de-cursos.md)
# O arquivo REAL é escrito na VPS por infra/provisionar-cursos.sh (INV-P8,
# Lei 5): nenhum valor de verdade entra neste exemplo, e nenhum agente vê o
# arquivo de lá.
#
# Toda variável abaixo é lida NO PONTO DE USO, nunca no import de um cliente:
# env ausente lido no `__init__` vira HTTP 500 em toda página, com o deploy
# verde (`armadilhas/097`).

# ── Fail-hard no import: sem uma destas duas, o container não sobe. ──────────
DJANGO_SECRET_KEY=            # OBRIGATÓRIA
DATABASE_URL=postgres://cursos_user:TROQUE_cursos@postgres:5432/cursos_db

DEBUG=0

# ── O prefixo público ───────────────────────────────────────────────────────
# O Traefik NÃO remove o prefixo; quem o aplica é esta variável, via
# FORCE_SCRIPT_NAME. O urls.py da célula não conhece `/cursos`. Mover a área
# de endereço é editar Traefik + esta linha, nunca código (`armadilhas/029`, e
# o guarda em services/cursos/tests/test_healthz_script_name.py).
#
# Nome da célula = nome da rota, de propósito (a mesma regra da `pages`, lei
# §6). Prefixo de duas letras casaria com a forma de idioma do roteador
# (`armadilhas/089`), e o inventário de rotas entra no MESMO PR do Traefik, no
# degrau 1.7.
SCRIPT_NAME=/cursos

# ── De que site é esta sala de aula ─────────────────────────────────────────
# A VARIÁVEL MAIS PERIGOSA DESTE ARQUIVO, e o perigo é ela FALTAR.
#
# A plataforma é multissítio (Lei 9 / [INV-P11]) e toda entidade desta célula
# nasce amarrada a um site: um curso por site no lançamento (lei §4). Esta
# célula não tem middleware para resolver o site pelo Host, e o único lugar
# onde a resposta existe é aqui.
#
# SE ELA FALTAR: o mapa das portas de uma escola inteira responde vazio, ou
# misturado com o de outro site, e nenhuma tela quebra para avisar. Numa célula
# cuja promessa é "o checkpoint abre a porta; o calendário, nunca", uma porta
# aberta no site errado é o pior modo de falha possível: ela não parece
# quebrada, parece injusta.
#
# Por isso ninguém digita este número à mão: o provisionamento PERGUNTA ao
# catálogo qual é o site e se RECUSA a terminar sem a resposta.
SITE_ID=TROQUE_uuid_do_site_no_catalogo

# ── Quem é a pessoa (par cursos->identidade) ────────────────────────────────
# A sala de aula repassa o cookie OPACO e pergunta. Esta célula nunca lê nem
# assina esse cookie ([INV-P12], guarda
# services/cursos/tests/test_inv_cursos_nao_assina_sessao.py): duas células
# assinando o mesmo cookie com chaves diferentes deslogam a plataforma inteira,
# sem erro em lugar nenhum (`armadilhas/143`). A tentação aqui tem dois nomes,
# a cerimônia do Boss e "o aluno já leu o laudo?", e as duas pedem memória. O
# estado mora no MODELO, nunca em `request.session`.
#
# A lei desta célula consome `getSessionFull` (a resposta COM e-mail): é o
# e-mail que a `alunos` pede no caminho para dizer se a pessoa tem matrícula.
# Esse degrau é `TOKENS_COMPLETOS_CURSOS` no env da IDENTIDADE, e
# `provisionar-cursos.sh` NÃO o abre: ele libera dado pessoal, e a lei da
# identidade (§6.3) exige o registro escrito do porquê. O registro está lá
# desde o degrau 1.8 (item `cursos`), e quem abre o degrau é
# `infra/provisionar-pares-da-sala-de-aula.sh` (degrau 1.8b): o MESMO token
# nas duas listas, numa linha idempotente que confere os dois lados.
#
# Os dois lados do par são escritos por infra/provisionar-cursos.sh, nunca à
# mão. A chave da lista mora no env da IDENTIDADE, porque quem autoriza é
# sempre o provedor.
IDENTIDADE_API_URL=http://identidade:8000/interno
IDENTIDADE_API_TOKEN=TROQUE_token_cursos_para_identidade

# ── Se a pessoa é aluna (par cursos->alunos) ────────────────────────────────
# O acesso à aula começa em "esta pessoa tem matrícula ativa?", e essa resposta
# mora na célula `alunos` (`getStudentStanding`), fail-CLOSED: falha aqui NUNCA
# vira "é aluno", vira "não é". Esta célula NUNCA copia a matrícula para o
# banco dela: seria o mesmo fato em dois lugares, que é a lei anti-duplicação
# da casa. `Pessoa` aqui é espelho mínimo (id da plataforma, nome de exibição).
#
# Reconhecer não é autorizar: o `papel` que a identidade devolve é de exibição.
# Quem decide se alguém vê a aula (a matrícula) e se alguém entra no plantão
# (as duas listas do fim deste arquivo) é esta célula.
#
# O endereço interno sai do `servers:` do contrato congelado da `alunos`, e não
# é escolha de ninguém.
ALUNOS_API_URL=http://alunos:8000/api/alunos
ALUNOS_API_TOKEN=TROQUE_token_cursos_para_alunos

# ── O menu do topo (par cursos->catalogo) ───────────────────────────────────
# A sala mostra o mesmo menu do site, e o menu é dado do `catalogo`
# (`getSiteByHost`). Fail-ABERTO, o único par desta célula assim: sem ele a
# sala abre igual, sem menu, e nenhuma tela quebra.
#
# O nome do token é `TOKEN_CATALOGO`, o mesmo que o fórum, a Caixa e a
# gamificação leem: é o que `apps/core/clients.py` lê, e um nome próprio aqui
# exigiria um roteiro só para esta célula. Escritas na VPS por
# `infra/provisionar-pares-da-sala-de-aula.sh` (degrau 1.8b), com o MESMO
# valor em `TOKENS_ACEITOS_CURSOS` do env do CATÁLOGO. O endereço sai do
# `servers:` do contrato congelado do catálogo.
CATALOGO_API_URL=http://catalogo:8000/api/catalogo
TOKEN_CATALOGO=TROQUE_token_cursos_para_catalogo

# ── O que ainda NÃO mora aqui, e a ausência é decisão ───────────────────────
# `REDIS_STREAMS_URL` não está neste arquivo. Quando o relay de eventos desta
# célula nascer (outbox + relay Huey, degrau 2.1), quem a entrega é o
# `infra/docker-compose.yml`, no serviço do relay, por `environment:`. Ela é
# topologia do compose, não configuração desta célula, e é assim na
# gamificação e nas outras.
#
# NADA DE PAGAMENTO mora aqui, e não é esquecimento: cobrar é da célula
# `pagamentos`, "aula atrás de pagamento dentro desta célula" é critério de
# morte da lei (§11), e pagamento vem por último (diretiva do mantenedor de
# 22/08/2026).
#
# NADA DE SERVIÇO DE VÍDEO mora aqui: onde os vídeos moram (o serviço, o custo,
# a restrição de quem assiste) é decisão que o mantenedor adiou para o degrau
# 1.8, em 04/09/2026. A variável entra quando ele decidir, e não antes.

# ── Quem pode chamar a porta de máquina desta célula ────────────────────────
# `provisionar-cursos.sh` NÃO escreve nenhuma destas, e a ausência é o desenho:
# cada par nasce com o consumidor que o pede. Uma variável por par consumidor,
# todas com o prefixo `TOKENS_ACEITOS_` (config/settings.py junta o conjunto).
#
# VAZIO = NINGUÉM, e aqui o conjunto vazio é o ÚNICO cadeado: esta célula roda
# sob SCRIPT_NAME e o corte do prefixo é do Django, não do Traefik, então a
# porta é alcançável pela borda pública (`armadilhas/186`). Não há topologia
# por baixo para segurar o que este conjunto deixar passar.
#
# O primeiro previsto pela escada (lei §10, degrau 1.5): o editor de aulas em
# `/admin/escola/aulas/`, que fala com a porta de máquina do degrau 1.3
# (`listLessons`, `putLesson`, `publishLesson`). O conteúdo do curso entra por
# essa porta e por nenhum arquivo commitado (critério de morte 8).
#
# QUEM AUTORIZA NÃO É ESTA CÉLULA. O Bearer prova só QUEM CHAMA; quem confere
# que é o mantenedor é a `admin`, sobre a lista dela ("reconhecer não é
# autorizar", `DECISAO-onde-mora-a-sessao` §4). Esta célula nem assina sessão.
#
# Escrita na VPS por `infra/provisionar-pares-da-sala-de-aula.sh` (degrau
# 1.8b), com o MESMO valor em `CURSOS_API_TOKEN` do env da ADMIN.
TOKENS_ACEITOS_ADMIN=TROQUE_token_admin_para_cursos

# ── Quem é do PLANTÃO (degrau 2.2) ──────────────────────────────────────────
# São DUAS listas, e quem entra em `/cursos/plantao` (vê a fila de revisão,
# escreve o laudo, decide, data) é a UNIÃO das duas.
#
# Os E-MAILS de quem entra, separados por vírgula. É e-mail mesmo, não id de
# plataforma: a comparação é contra o e-mail que a `identidade` devolve, sem
# diferenciar maiúscula de minúscula e ignorando espaço nas pontas.
#
# AS DUAS VAZIAS = NINGUÉM, e é o desenho: uma variável esquecida não pode
# virar permissão para o site inteiro dar laudo nos outros. Fail-closed sem
# fail-hard: a célula sobe, `/cursos` responde, e só o plantão fica fechado.
#
# NÃO é o `papel` que a identidade devolve, e a diferença é lei da casa
# ("reconhecer não é autorizar"): aquele campo é de exibição, e responde "esta
# pessoa é professora na plataforma?", não "esta pessoa pode decidir se a porta
# deste aluno abre?".
#
# QUEM A ESCREVE: `infra/abrir-a-sala-de-aula.sh` não toca nesta linha, porque
# ela é escolha do mantenedor sobre gente. `infra/provisionar-cursos.sh` a
# PRESERVA relendo do env vivo: ele reescreve o arquivo inteiro, e sem essa
# releitura re-provisionar apagaria a lista em silêncio (`armadilhas/111`).
CURSOS_PROFESSORES=

# ── Quem já entra no /admin/ do site, e por isso no plantão ─────────────────
# Decisão do mantenedor em 05/09/2026, com as palavras dele: "qualquer admin
# do site pode abrir" o plantão.
#
# A MESMA lista de `env/admin.env`, copiada para cá. Sem ela, o mantenedor
# teria de se pôr numa segunda lista à mão para entrar na própria escola, e
# esquecer essa segunda lista é fail-closed silencioso: o plantão fecha para o
# dono e nenhuma tela explica por quê.
#
# É uma FOTOGRAFIA, não uma ligação viva: cada célula lê o próprio env_file, e
# não existe env comum nesta plataforma. Se a lista mudar no painel, rode de
# novo `infra/abrir-a-sala-de-aula.sh` para a sala acompanhar. O molde é o do
# fórum, que faz a mesma cópia desde 28/08/2026.
#
# QUEM A ESCREVE: `infra/abrir-a-sala-de-aula.sh`, que a copia de
# `env/admin.env`, e nunca a mão. `infra/provisionar-cursos.sh` a relê da mesma
# fonte quando reescreve o arquivo.
#
# VAZIA = NINGUÉM, e é fail-closed de propósito.
ADMIN_EMAILS=

# ── O Assistente de laudo (degrau 2.3) ──────────────────────────────────────
# A chave da API da Anthropic. É com ela que o botão "Rascunhar laudo" existe
# no formulário do plantão. A IA prepara e nunca publica: pré-preenche a
# rubrica, sugere três forças e UMA mudança, e a pessoa decide, data e assina.
#
# ESTA É A ÚNICA VARIÁVEL DESTE ARQUIVO QUE O PROVISIONAMENTO NÃO SABE GERAR:
# ela nasce na conta da Anthropic do mantenedor (console.anthropic.com), custa
# dinheiro por uso, e ninguém além dele pode criá-la. Nenhum roteiro desta casa
# a inventa: ela é copiada do fórum, que é onde ele já a colou.
#
# VAZIA = A IA DESLIGADA, e desligada é um estado honesto: a sala de aula sobe
# igual, o plantão continua de pé, e só o botão "Rascunhar laudo" falha, em
# português, dizendo o que falta. Nada quebra e nada é cobrado.
#
# Lida no PONTO DE USO (molde: `services/forum/apps/core/agente.py`), nunca no
# import: trocar a chave aqui passa a valer na geração seguinte, sem reiniciar.
#
# QUEM A ESCREVE, desde 05/09/2026: `infra/abrir-a-sala-de-aula.sh`, e nunca a
# mão. Ele a COPIA de `env/forum.env`, onde o mantenedor já a colou em
# 02/09/2026: é a mesma conta e o mesmo teto de gasto, e pedir a mesma chave
# duas vezes só criaria mais uma chance de ela aparecer numa tela.
# `infra/provisionar-cursos.sh` a PRESERVA relendo deste arquivo, porque ele o
# reescreve inteiro e sem a releitura a apagaria em silêncio (`armadilhas/111`).
ANTHROPIC_API_KEY=

# EM QUAL WORKSPACE a chamada age. Opcional, e depende do TIPO da chave acima:
# a chave clássica (de workspace) já carrega isso; a chave nova, ligada à
# identidade de quem a criou, é RECUSADA sem ele, com HTTP 400. Medido no
# fórum, na primeira vez que o botão foi usado de verdade, em 02/09/2026.
# O SDK NÃO lê esta variável sozinho quando a chave é passada no código; quem
# manda o cabeçalho é o `agente.py`. Vazio = não mando o cabeçalho, que é o
# certo para chave de workspace, e por isso o vazio aqui nunca para roteiro
# nenhum. Escrita e preservada pelos mesmos dois roteiros da linha acima.
ANTHROPIC_WORKSPACE_ID=
