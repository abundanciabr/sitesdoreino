# Célula: identidade — o login do site (DECISAO-celula-de-identidade)
# Copie para /opt/plataforma/env/identidade.env e preencha. O arquivo REAL é
# segredo, escrito à mão na VPS pelo mantenedor (INV-P8, Lei 5): nenhum valor
# de verdade entra neste exemplo, e nenhum agente vê o arquivo de lá.
#
# NÃO tem ALLOWED_HOSTS de propósito: esta célula fixa ALLOWED_HOSTS = ["*"] no
# config/settings.py e NÃO lê a variável — declarar aqui seria decoração que um
# dia alguém acredita (armadilhas/029, seção "de quebra").
#
# NÃO tem SCRIPT_NAME de propósito: os caminhos públicos (/entrar/…) são
# declarados por extenso no urls.py — o retorno do Google é o endereço EXATO
# cadastrado no console em 24/08/2026, sem prefixo de célula.

# ── Fail-hard no import: sem uma destas duas, o container não sobe. ──────────
DJANGO_SECRET_KEY=            # OBRIGATÓRIA — é ela que ASSINA o cookie do site
DATABASE_URL=postgres://identidade_user:TROQUE_identidade@postgres:5432/identidade_db

DEBUG=0

# ── Google: prova QUEM É ────────────────────────────────────────────────────
# O aplicativo OAuth é o MESMO da Caixa (criado pelo mantenedor em 24/08/2026,
# DECISAO-EVO-01 §6) — copie os dois valores de env/sugestoes.env. O endereço
# de retorno desta célula já está cadastrado nele desde aquele dia:
#   https://meshcraft.top/entrar/google/retorno
# Lidas no PONTO DE USO (apps/core/clients.py): faltando, quem fecha é só a
# porta de entrada — o container sobe e a API interna continua servindo.
GOOGLE_CLIENT_ID=TROQUE_id_do_cliente_do_google
GOOGLE_CLIENT_SECRET=TROQUE_segredo_do_cliente_do_google

# ── Quem é staff PARA EXIBIÇÃO (papel na resposta de /sessao) ───────────────
# Lista de e-mails separados por vírgula. O papel NÃO é gravado em lugar
# nenhum: é derivado desta lista a cada requisição. ATENÇÃO — este papel nunca
# autoriza nada (DECISAO-onde-mora-a-sessao §4): a lista que dá moderação da
# Caixa é a SUGESTOES_STAFF_EMAILS, no env DELA. Normalmente as duas têm o
# mesmo conteúdo, mas são decisões separadas de propósito.
IDENTIDADE_STAFF_EMAILS=voce@exemplo.com

# ── Tokens dos PARES consumidor→provedor (R1), um por par ───────────────────
# Quem pode PERGUNTAR "quem é o dono desta sessão?" (/interno/sessao):
TOKENS_ACEITOS_FUNIL=TROQUE_token_funil_para_identidade
TOKENS_ACEITOS_SUGESTOES=TROQUE_token_sugestoes_para_identidade
# Quem, ALÉM de perguntar, pode receber o E-MAIL (/interno/sessao/completa) —
# só célula que autoriza recurso próprio sobre o e-mail entra aqui (a Caixa:
# matrícula e staff). O `funil` NÃO entra, por desenho (DECISAO §4). O valor é
# o MESMO token do par acima — o degrau é estar listado também aqui:
TOKENS_COMPLETOS_SUGESTOES=TROQUE_token_sugestoes_para_identidade
