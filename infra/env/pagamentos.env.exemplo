# =============================================================================
# Célula: pagamentos — A FORTALEZA. ⚠ LEIA INV-P8 ANTES DE PREENCHER ⚠
# Este exemplo e TODO ambiente de desenvolvimento usam SOMENTE sandbox (TEST-...).
# A credencial de PRODUÇÃO (APP_USR-...) existe em UM único lugar no universo:
# /opt/plataforma/env/pagamentos.env na VPS, escrito manualmente pelo mantenedor.
# O CI reprova qualquer APP_USR- no repositório (ci/guarda-de-segredos.sh).
# =============================================================================
DJANGO_SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=SEU-DOMINIO.com.br,pagamentos   # domínio de OPERAÇÕES (webhooks) + rede interna
DATABASE_URL=postgres://pagamentos_user:TROQUE_pagamentos@postgres:5432/pagamentos_db
REDIS_STREAMS_URL=redis://redis:6379/0
HUEY_REDIS_URL=redis://redis:6379/5
MP_ACCESS_TOKEN=TEST-TROQUE
MP_WEBHOOK_SECRET=TROQUE          # valida x-signature (INV-P10)
PUBLIC_BASE_URL=https://SEU-DOMINIO.com.br   # DOMÍNIO DE OPERAÇÕES — endereço estável dos webhooks, independe dos sites
TOKENS_ACEITOS_CHECKOUT=TROQUE_token_checkout_para_pagamentos

# =============================================================================
# Appmax (TAR-542, escada L0-INFRA). MESMA regra do INV-P8 acima: a credencial
# de PRODUÇÃO da Appmax existe em UM único lugar no universo:
# /opt/plataforma/env/pagamentos.env na VPS, escrito manualmente pelo
# mantenedor. Este exemplo e TODO ambiente de desenvolvimento nascem SEM
# valor: a lógica que consome estas chaves é de outro lote da escada, ainda
# não existe nesta célula, e um valor de sandbox aqui não tem serventia hoje.
# =============================================================================
APPMAX_AUTH_URL=                # endereço de autenticação (OAuth) da API da Appmax
APPMAX_API_URL=                 # endereço base da API da Appmax
APPMAX_APP_ID=                  # identificador do aplicativo cadastrado na Appmax
APPMAX_APP_CLIENT_ID=           # client_id do aplicativo (par OAuth do app)
APPMAX_APP_CLIENT_SECRET=       # client_secret do aplicativo (par OAuth do app)
APPMAX_MERCHANT_CLIENT_ID=      # client_id do lojista (par OAuth do merchant)
APPMAX_MERCHANT_CLIENT_SECRET=  # client_secret do lojista (par OAuth do merchant)
APPMAX_EXTERNAL_ID=             # identificador externo exigido pela Appmax a cada chamada
# Trava nova deste projeto: lista de site_id separados por vírgula. Vazia
# impede QUALQUER cobrança nova no cartão via Appmax, em qualquer site. Nasce
# vazia de propósito — ligar um site aqui é decisão do mantenedor, nunca
# automática ou de um deploy.
APPMAX_CARD_ENABLED_SITES=
