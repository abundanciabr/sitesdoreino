# Célula: admin — a área administrativa (DECISAO-celula-admin)
# Copie para /opt/plataforma/env/admin.env e preencha. O arquivo REAL é
# segredo, escrito na VPS pelo script `infra/provisionar-admin.sh` (INV-P8,
# Lei 5): nenhum valor de verdade entra neste exemplo, e nenhum agente vê o
# arquivo de lá.
#
# NÃO tem ALLOWED_HOSTS de propósito: esta célula fixa ALLOWED_HOSTS = ["*"] no
# config/settings.py e NÃO lê a variável — declarar aqui seria decoração que um
# dia alguém acredita (armadilhas/029, seção "de quebra"). Quem prende a área
# administrativa a um host é o Traefik, com `Host(meshcraft.top)` no router.

# ── Fail-hard no import: sem uma destas duas, o container não sobe. ──────────
DJANGO_SECRET_KEY=            # OBRIGATÓRIA
DATABASE_URL=postgres://admin_user:TROQUE_admin@postgres:5432/admin_db

DEBUG=0

# ── O prefixo público ───────────────────────────────────────────────────────
# O Traefik NÃO remove o prefixo; quem o aplica é esta variável, via
# FORCE_SCRIPT_NAME. O urls.py da célula não conhece `/admin` — mover a área de
# endereço é editar Traefik + esta linha, nunca código (armadilhas/029, e o
# guarda em services/admin/tests/test_healthz_script_name.py).
SCRIPT_NAME=/admin

# ── Quem é a pessoa (a pergunta à identidade) ───────────────────────────────
# A área admin NÃO tem login próprio: usa o do site. Ela repassa o cookie
# `meshcraft_sessao` e pergunta quem é — nunca lê nem assina esse cookie
# (INV-P12). Lidas no PONTO DE USO, nunca no __init__ de um cliente
# (armadilhas/097: env ausente no __init__ vira HTTP 500 em toda página).
#
# O token é o do par `admin→identidade`, e ele precisa estar registrado nos
# DOIS degraus do lado da identidade — `TOKENS_ACEITOS_ADMIN` (prova quem
# chama) e `TOKENS_COMPLETOS_ADMIN` (autoriza receber o e-mail), com o MESMO
# valor. O script de provisionamento escreve os dois e confere.
IDENTIDADE_API_URL=http://identidade:8000/interno
IDENTIDADE_API_TOKEN=TROQUE_token_admin_para_identidade

# ── Quem PODE ENTRAR na área administrativa ─────────────────────────────────
# Lista de e-mails separados por vírgula, e a ÚNICA fonte de "pode entrar"
# (DECISAO-celula-admin §2). Nasce como cópia de IDENTIDADE_STAFF_EMAILS, mas
# não fica atrelada a ela: mudar quem é admin é editar esta linha e reiniciar.
#
# ATENÇÃO ao que esta lista NÃO é: o `papel` que a identidade devolve nunca
# autoriza nada aqui, nem o e-mail por si — quem decide é esta lista, na hora,
# derivada e nunca gravada. E quem não está nela recebe 404, não 403: para quem
# não é da casa, /admin não existe.
ADMIN_EMAILS=voce@exemplo.com

# ── A fila de liberação (DECISAO-categorias-de-usuario) ─────────────────────
# Escritas na VPS por `infra/provisionar-pares-de-categorias.sh`. Lidas no
# PONTO DE USO, nunca no __init__ de um cliente (armadilhas/097). Ausentes, a
# área administrativa abre normalmente e só a tela da fila diz que não
# consegue perguntar — nunca 500.
ALUNOS_API_URL=http://alunos:8000/api/alunos
ALUNOS_API_TOKEN=TROQUE_token_admin_para_alunos

# ── O MENU DO TOPO DO SITE (a tela /admin/menu/, 31/08/2026) ────────────────
# O menu e DADO DO SITE, e dado de site mora no `catalogo`. Esta area LE e
# GRAVA o menu la, pela porta de maquina — nunca no banco dele (Lei 3), e
# nunca guardando uma copia aqui (seria o mesmo fato em dois lugares).
#
# Escritas na VPS por `infra/provisionar-par-do-menu.sh`. Lidas no PONTO DE USO,
# nunca no __init__ de um cliente (armadilhas/097). Ausentes, a area abre
# normalmente e so a tela do menu diz que ainda nao consegue perguntar — nunca
# 500, e nada do que esta no ar muda.
#
# O token e o do par `admin→catalogo`, e precisa estar tambem em
# TOKENS_ACEITOS_ADMIN do lado do catalogo, com o MESMO valor. O script escreve
# os dois e confere.
CATALOGO_API_URL=http://catalogo:8000/api/catalogo
TOKEN_CATALOGO=TROQUE_token_admin_para_catalogo

# ── A tela dos interruptores da economia (`/admin/economia/`) ───────────────
# A economia da escola (quanto vale cada coisa) e DADO da celula `gamificacao`,
# e mora la. Esta tela le e grava por esta porta — nunca no banco dela, e nunca
# guardando uma copia aqui (seria o mesmo fato em dois lugares).
#
# Escritas na VPS por `infra/provisionar-par-da-economia.sh`. Lidas no PONTO DE
# USO, nunca no __init__ de um cliente (armadilhas/097). Ausentes, a area abre
# normalmente e so a tela da economia diz que ainda nao consegue perguntar —
# nunca 500, e nada do que esta no ar muda: a economia continua desligada.
#
# O token e o do par `admin→gamificacao`, e precisa estar tambem em
# TOKENS_ACEITOS_ADMIN do lado da gamificacao, com o MESMO valor. E um valor
# PROPRIO, diferente do TOKEN_CATALOGO acima: token e por par, e um so faria a
# rotacao de um derrubar o outro sem aviso. O script escreve os dois, confere, e
# se recusa a gravar se os dois pares ficarem iguais.
GAMIFICACAO_API_URL=http://gamificacao:8000/api/gamificacao
TOKEN_GAMIFICACAO=TROQUE_token_admin_para_gamificacao

# Escritas na VPS por `infra/provisionar-par-do-teste-de-aviso.sh`. Lidas no
# PONTO DE USO (armadilhas/097). Ausentes, a tela /admin/avisos/ abre
# normalmente e o botao diz "Nao deu para saber" ao clicar — nunca 500, e
# nada do que esta no ar muda: os avisos de verdade (fio de eventos) nao
# usam este par.
#
# O token e o do par `admin->notificacoes`, e precisa estar tambem em
# TOKENS_ACEITOS_ADMIN do lado da notificacoes, com o MESMO valor. E um
# valor PROPRIO, diferente dos outros pares do admin acima: token e por
# par, e um so faria a rotacao de um derrubar o outro sem aviso.
NOTIFICACOES_API_URL=http://notificacoes:8000/api/notificacoes
NOTIFICACOES_API_TOKEN=TROQUE_token_admin_para_notificacoes

# ── O editor de aulas (`/admin/escola/aulas/`, PLANO-CELULA-CURSOS §10) ─────
# O conteúdo do curso mora na célula `cursos` e entra por esta porta de
# máquina (listLessons, putLesson, publishLesson), nunca por arquivo commitado.
# Lidas no PONTO DE USO (armadilhas/097). Ausentes, a área abre normalmente e
# só o editor diz que ainda não consegue falar com a sala de aula, nunca 500.
#
# O token é o do par `admin->cursos`, e precisa estar também em
# TOKENS_ACEITOS_ADMIN do lado da cursos, com o MESMO valor. É um valor
# PRÓPRIO, diferente dos outros pares acima: token é por par. Escritas na VPS
# por `infra/provisionar-pares-da-sala-de-aula.sh` (degrau 1.8b); o endereço
# sai do `servers:` do contrato congelado da cursos.
CURSOS_API_URL=http://cursos:8000/api/cursos
CURSOS_API_TOKEN=TROQUE_token_admin_para_cursos

# ── Quem pode PERGUNTAR a esta célula (a porta de máquina dela) ─────────────
# Esta célula passou a RESPONDER por máquina em 06/09/2026: a `pages` pergunta
# aqui se uma pessoa é administradora da escola, para abrir a fila onde se
# confere o portfólio do aluno (`isAdministrator`, do contrato congelado
# `contracts/admin.openapi.yaml`). Uma variável por par consumidor, todas com o
# prefixo `TOKENS_ACEITOS_`, e o `config/settings.py` junta o conjunto.
#
# CONJUNTO VAZIO = NINGUÉM, e aqui ele é o ÚNICO cadeado: esta célula roda sob
# `SCRIPT_NAME=/admin` e o corte do prefixo é do Django, não do Traefik, então
# a porta é alcançável pela borda pública em `meshcraft.top/admin/interno/...`
# (`armadilhas/186`). Ausente, toda chamada leva 401, a área administrativa
# continua de pé e só a fila do portfólio fica indisponível, dizendo em
# português que não deu para perguntar agora.
#
# QUEM ESCREVE ESTA LINHA: `infra/provisionar-par-do-portfolio-com-a-admin.sh`,
# na VPS, com o mesmo valor de `ADMIN_API_TOKEN` no env da `pages`.
# `infra/provisionar-admin.sh` reescreve este arquivo inteiro e por isso a
# PRESERVA, relendo o valor vivo antes de escrever (`armadilhas/111`).
TOKENS_ACEITOS_PAGES=TROQUE_token_pages_para_admin
