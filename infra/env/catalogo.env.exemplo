# Célula: catalogo — copie para /opt/plataforma/env/catalogo.env e preencha
DJANGO_SECRET_KEY=            # OBRIGATÓRIA — sem valor, ImproperlyConfigured (sem fallback)
DEBUG=0
ALLOWED_HOSTS=catalogo   # API interna: só a rede Docker fala com ela
DATABASE_URL=postgres://catalogo_user:TROQUE_catalogo@postgres:5432/catalogo_db
HUEY_REDIS_URL=redis://redis:6379/1
# Tokens ACEITOS pelos consumidores desta API (um por par):
TOKENS_ACEITOS_CHECKOUT=TROQUE_token_checkout_para_catalogo
TOKENS_ACEITOS_FUNIL=TROQUE_token_funil_para_catalogo
TOKENS_ACEITOS_QUIZ=TROQUE_token_quiz_para_catalogo
TOKENS_ACEITOS_ALUNOS=TROQUE_token_alunos_para_catalogo
# A sala de aula (célula `cursos`, 05/09/2026) lê o menu do topo do site
# (getSiteByHost). Escrito na VPS por infra/provisionar-pares-da-sala-de-aula.sh;
# precisa bater com o TOKEN_CATALOGO de env/cursos.env.
TOKENS_ACEITOS_CURSOS=TROQUE_token_cursos_para_catalogo
