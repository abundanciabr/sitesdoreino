# Célula: mensageria
DJANGO_SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=mensageria   # API interna
DATABASE_URL=postgres://mensageria_user:TROQUE_mensageria@postgres:5432/mensageria_db
REDIS_STREAMS_URL=redis://redis:6379/0
HUEY_REDIS_URL=redis://redis:6379/7
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=contato@SEU-DOMINIO.com.br
# Escritos juntos por infra/provisionar-evolution.sh. Vazios bloqueiam o canal.
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=
# WhatsApp oficial (Cloud API da Meta): modelos aprovados para o primeiro contato.
# Vazios = canal oficial ainda não ligado (a tela /admin/crm/modelos/ diz isso).
# Retorno a cadastrar na Meta: https://meshcraft.top/webhooks/whatsapp/cloud
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
# Conversas nos dois sentidos (apps/conversas). Vazios: o webhook oficial da
# Meta recusa, a resposta de e-mail usa EMAIL_WEBHOOK_TOKEN e a ligação com o
# lead fica pendente (a conversa é gravada mesmo assim).
EMAIL_ENTRADA_TOKEN=
LEADS_API_URL=http://leads:8000/api/leads
LEADS_API_TOKEN=
# Descadastro grava a preferência das jornadas pelo id de plataforma
# (POST /pessoas/por-email exige o par em TOKENS_COMPLETOS_* da identidade).
IDENTIDADE_API_URL=http://identidade:8000/interno
IDENTIDADE_API_TOKEN=
