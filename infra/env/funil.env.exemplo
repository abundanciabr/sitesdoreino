# Célula: funil — a única célula SEM banco (stateless)
DJANGO_SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=*   # multissítio: o middleware CONV-SITE valida o Host (INV-P11)
# Consome (server-side, com token dedicado por par):
CATALOGO_API_URL=http://catalogo:8000/api/catalogo
TOKEN_CATALOGO=TROQUE_token_funil_para_catalogo
LEADS_API_URL=http://leads:8000/api/leads
TOKEN_LEADS=TROQUE_token_funil_para_leads
# identidade — quem e a pessoa desta requisicao (DECISAO-celula-de-identidade).
# Escritas pelo infra/provisionar-identidade.sh, nao a mao.
# Faltando qualquer uma das duas, esta celula NAO cai: ela mostra "Entrar" para
# todo mundo e registra ERROR no log (fail-open de configuracao, guarda em
# tests/test_sessao_no_site.py). Ate a auditoria de 25/08/2026 ela devolvia 500
# em toda pagina para quem tivesse cookie — por isso este molde existe.
IDENTIDADE_API_URL=http://identidade:8000/interno
IDENTIDADE_API_TOKEN=TROQUE_token_funil_para_identidade
# notificacoes — o sino ao lado do nome (Fase 5, docs/notificacoes/PLANO-MESTRE.md).
# MESMO fail-open de configuracao do par acima, guarda em tests/test_sino.py:
# faltando qualquer uma das duas, o site mostra o nome SEM sino (nunca 500) e
# registra ERROR no log. Ausentes ate o passo de provisionamento na VPS — isso
# e esperado, nao e bug (comportamento medido e coberto por teste).
NOTIFICACOES_API_URL=http://notificacoes:8000/api/notificacoes
NOTIFICACOES_API_TOKEN=TROQUE_token_funil_para_notificacoes
# Endereco publico da porta de entrada. Default no codigo: /entrar/google.
URL_DE_ENTRADA=/entrar/google
# Endereco publico da tela de avisos da Caixa (destino do sino). Default no
# codigo: /forms/sugestoes/avisos.
URL_DOS_AVISOS=/forms/sugestoes/avisos

# ── As cinco categorias de usuário (DECISAO-categorias-de-usuario) ──────────
# Escritas na VPS por `infra/provisionar-pares-de-categorias.sh`. A home
# pergunta em que categoria a pessoa está para decidir o que mostrar.
# FAIL-OPEN quanto à PÁGINA: sem estas variáveis, ou com a `alunos` fora do ar,
# a home trata todo mundo como `Cadastrado` e abre. A vitrine não cai porque
# uma célula de produto caiu — e esconder um botão nunca foi proteção.
ALUNOS_API_URL=http://alunos:8000/api/alunos
ALUNOS_API_TOKEN=TROQUE_token_funil_para_alunos
