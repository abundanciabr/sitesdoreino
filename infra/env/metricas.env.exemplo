# Célula: metricas — o livro de fatos (PLANO-PAINEL-DE-GESTAO.md §6.2)
# O arquivo REAL é escrito na VPS por infra/provisionar-metricas.sh (INV-P8,
# Lei 5): nenhum valor de verdade entra neste exemplo, e nenhum agente vê o
# arquivo de lá.
#
# Este é o env mais curto da plataforma, e a curteza é o desenho da célula: ela
# não conversa com ninguém por API, então não há par de token; e não tem tela,
# então não há prefixo público nem cookie de sessão.

# ── Fail-hard no import: sem uma destas duas, o container não sobe. ──────────
DJANGO_SECRET_KEY=            # OBRIGATÓRIA
DATABASE_URL=postgres://metricas_user:TROQUE_metricas@postgres:5432/metricas_db

DEBUG=0

# ── O que NÃO mora aqui, e cada ausência é decisão ──────────────────────────
#
# `SITE_ID` não está aqui, e esta é a diferença mais importante entre este env e
# o das outras células. A plataforma é multissítio (Lei 9 / [INV-P11]), e as
# outras células precisam saber de que site elas são. Esta não: o site de cada
# fato vem DENTRO do evento (`data.site_id`, em todo contrato de
# `contracts/eventos/`), e a recepção RECUSA o evento que chegar sem ele. Fixar
# um site no env desta célula seria pior que inútil — ela passaria a contar
# como sendo de um site fatos que são de outro.
#
# `REDIS_STREAMS_URL` não está aqui. Quem a entrega é o
# `infra/docker-compose.yml`, no serviço `metricas-eventos`, por `environment:`
# — ela é topologia do compose, não configuração desta célula, e é assim na
# gamificação e nas outras consumidoras.
#
# `SCRIPT_NAME` não está aqui, e não vai estar: esta célula não tem endereço
# público. O `FORCE_SCRIPT_NAME` do settings continua lendo a variável, e o
# guarda de `tests/test_healthz_script_name.py` continua medindo o
# comportamento sob prefixo, para o dia em que a porta de máquina nascer.
#
# Nenhuma variável de API de outra célula está aqui, e nunca estará: esta célula
# não pergunta nada a ninguém. O que o evento não trouxer, ela não sabe, e
# "não sei" é resposta legítima (`constituicoes/AGENTS.metricas.md`).

# ── Quem pode chamar a porta de leitura desta célula ────────────────────────
# NÃO é escrito pelo provisionamento, e a ausência é o desenho: cada par nasce
# com o consumidor que o pede. Uma variável por par consumidor, todas com o
# prefixo `TOKENS_ACEITOS_`.
#
# VAZIO = NINGUÉM, e é o que se quer hoje: a porta de leitura ainda não existe
# (degrau 7.4 da escada). Quando existir, o primeiro e provavelmente único
# consumidor é a `admin`, que é quem mostra número nesta casa.
# TOKENS_ACEITOS_ADMIN=   # degrau 7.4: a admin lendo a história dos números
