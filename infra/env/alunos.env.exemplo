# Célula: alunos
DJANGO_SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=*   # multissítio: o middleware CONV-SITE valida o Host (INV-P11)
SCRIPT_NAME=/alunos
DATABASE_URL=postgres://alunos_user:TROQUE_alunos@postgres:5432/alunos_db
REDIS_STREAMS_URL=redis://redis:6379/0
HUEY_REDIS_URL=redis://redis:6379/6
# Resolução de site (middleware CONV-SITE):
CATALOGO_API_URL=http://catalogo:8000/api/catalogo
TOKEN_CATALOGO=TROQUE_token_alunos_para_catalogo
# Tokens ACEITOS por esta API, um por par consumidor. O config/settings.py
# desta célula monta o conjunto a partir de QUALQUER variável TOKENS_ACEITOS_*,
# então acrescentar um consumidor é acrescentar UMA linha aqui — nunca código.
# A Caixa de Sugestões pergunta se o e-mail que entrou pelo Google tem
# matrícula (operação listEnrollments do contrato). Precisa bater com o
# ALUNOS_API_TOKEN de env/sugestoes.env.
TOKENS_ACEITOS_SUGESTOES=TROQUE_token_sugestoes_para_alunos
# Integrações externas: nenhuma na Fase 0. Cada ponte entra por brief próprio,
# sob a lei da ponte (constituicoes/AGENTS.alunos.md), com flag e token dedicados.

# ── Quem pode PERGUNTAR a esta célula (DECISAO-categorias-de-usuario) ───────
# Um par por consumidor. Escritos na VPS por
# `infra/provisionar-pares-de-categorias.sh`, que gera os segredos lá dentro —
# nenhum valor de verdade entra neste exemplo (INV-P8, Lei 5).
#
# `admin` usa a fila (GET/POST /pre-matriculas); `funil` usa só
# GET /alunos/{email}/situacao, para a home saber o que mostrar a cada pessoa.
TOKENS_ACEITOS_ADMIN=TROQUE_token_admin_para_alunos
TOKENS_ACEITOS_FUNIL=TROQUE_token_funil_para_alunos
