; =============================================================================
; A ARQUITETURA DIZ "NÃO" AO AGENTE — em check time, antes de qualquer runtime.
; Roda no `make lint` da fortaleza. INV-P9.
; =============================================================================
[importlinter]
root_package = pagamentos

[importlinter:contract:pix-e-card-invisiveis]
name = INV-P9 - Pix e cartao mutuamente invisiveis
type = independence
modules =
    pagamentos.methods.pix
    pagamentos.methods.card

[importlinter:contract:metodos-so-falam-com-core]
name = Metodos falam com o MP apenas atraves de core.gateway
type = forbidden
source_modules =
    pagamentos.methods.pix
    pagamentos.methods.card
forbidden_modules =
    pagamentos.providers
; "forbidden" checa a cadeia INTEIRA por padrão (import indireto também conta) —
; sem esta linha, o próprio core.gateway chamando providers.* já quebraria o
; contrato para quem importa core.gateway, mesmo sendo exatamente o caminho que
; AGENTS.pagamentos manda usar ("Métodos não importam providers.* diretamente —
; só através de core.gateway"). allow_indirect_imports restringe a checagem a
; import DIRETO, que é a regra que este contrato realmente pretende impor.
allow_indirect_imports = True
