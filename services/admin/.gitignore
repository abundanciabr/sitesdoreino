__pycache__/
*.pyc
.pytest_cache/
staticfiles/
.env.dev

# A cópia do painel do dono que o deploy embute no contexto do build
# (`apps/core/painel.py`). NÃO se commita: duas pastas com os mesmos registros
# dentro do repositório seria exatamente a duplicação que o CLAUDE.md proíbe —
# a célula SERVE o painel, não guarda uma cópia dele.
painel_embutido/

# A regra da dívida do livro (`ci/divida_do_livro.py`), embutida pelo mesmo
# passo do deploy. Também não se commita: a fonte é `ci/`, e uma cópia
# versionada aqui viraria a segunda definição de "contado".
regra_do_livro/

# A fila de trabalho (`fila/`) + estados materializados, embutidos pelo deploy
# para a aba "Os robôs" (`apps/core/robos.py`). Mesma lei das duas de cima: a
# fonte é `fila/` na raiz; cópia versionada aqui seria a segunda casa do fato.
fila_embutida/

# A área de documentos (`documentos/`), embutida pelo mesmo passo do deploy
# (`apps/core/documentos.py`). Mesma lei das três de cima — e aqui ela tem um
# lado extra: dois lugares com o mesmo documento significa dois cabeçalhos
# `publico:`, e o dia em que discordassem um texto interno estaria no ar.
documentos_embutidos/

# Os planos para IA (`docs/decisoes/`), embutidos pelo mesmo passo do deploy
# (`apps/core/planos_para_ia.py`). Mesma lei das de cima: a celula SERVE a
# pasta, nunca guarda copia dela — duas copias divergiriam, e a que o site
# mostra seria a errada.
planos_embutidos/
