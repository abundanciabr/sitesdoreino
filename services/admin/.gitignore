__pycache__/
*.pyc
.pytest_cache/
staticfiles/
.env.dev

# A área de documentos (`documentos/`), embutida pelo mesmo passo do deploy
# (`apps/core/documentos.py`). Dois lugares com o mesmo documento significam
# dois cabeçalhos `publico:`, e o dia em que discordassem um texto interno
# estaria no ar.
documentos_embutidos/

# Os planos para IA (`docs/decisoes/`), embutidos pelo mesmo passo do deploy
# (`apps/core/planos_para_ia.py`). Mesma lei das de cima: a celula SERVE a
# pasta, nunca guarda copia dela — duas copias divergiriam, e a que o site
# mostra seria a errada.
planos_embutidos/
